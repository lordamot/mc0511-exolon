; ------------------------------------------------------------------
; Score, the dirty-rectangle list, the title/menu screen and the game
; cycle.
; ------------------------------------------------------------------

; ---- dirty rectangles --------------------------------------------
; Everything that draws into the back buffer marks the cells it
; touched; BLIT_MARKS pushes them to the screen once per frame.  A
; full-screen redraw is cheaper than a long list, so the list simply
; saturates.
;
; Bits, not a list: a bit per cell, two words per row.  Marking is a
; couple of masks however big the rectangle, the blit pass walks the
; bitmap once and pushes every dirty cell to the screen exactly once,
; and nothing is ever dropped for want of a list slot.
MASKTAB:	.WORD	0,1,3,7,17,37,77,177,377
		.WORD	777,1777,3777,7777,17777,37777,77777,177777

MARKS_CLEAR:	MOV	#DIRTY,R0
		MOV	#2*NROWS,R1
1$:		CLR	(R0)+
		SOB	R1,1$
		RETURN

; R0 = row, R1 = col, R2 = width, R3 = height.  Preserves R0..R3;
; R4 comes back zero when every cell was already dirty, which is also
; the answer to "has this patch been repainted this frame".
MARK_RECT:	MOV	R0,-(SP)
		MOV	R1,-(SP)
		MOV	R2,-(SP)
		MOV	R3,-(SP)
		CLR	MRNEW
		CALL	CLIPRECT
		BEQ	7$
		MOV	R0,MRROW	; the clipped row
		CLR	MRML		; the row masks, built once
		CLR	MRMR
		MOV	R1,R4		; left word: bits col..15
		CMP	R4,#16.
		BHIS	2$
		MOV	R2,R5		; n = min(width, 16 - col)
		MOV	#16.,R0
		SUB	R4,R0
		CMP	R5,R0
		BLOS	1$
		MOV	R0,R5
1$:		ASL	R5
		MOV	MASKTAB(R5),R5
		MOV	R4,R0
		BEQ	11$
10$:		ASL	R5
		SOB	R0,10$
11$:		MOV	R5,MRML
2$:		MOV	R1,R4		; right word: bits 16..col+w-1
		ADD	R2,R4
		CMP	R4,#16.
		BLOS	4$
		SUB	#16.,R4		; end bit in the right word
		MOV	R1,R5
		SUB	#16.,R5		; start bit (clamped at 0)
		BGE	3$
		CLR	R5
3$:		SUB	R5,R4		; n bits from R5
		ASL	R4
		MOV	MASKTAB(R4),R4
		MOV	R5,R0
		BEQ	31$
30$:		ASL	R4
		SOB	R0,30$
31$:		MOV	R4,MRMR
4$:		MOV	MRROW,R0
		ASL	R0
		ASL	R0
		ADD	#DIRTY,R0	; two words per row
5$:		MOV	MRML,R4		; new bits = mask & ~word
		BIC	(R0),R4
		BIS	R4,MRNEW
		BIS	MRML,(R0)+
		MOV	MRMR,R4
		BIC	(R0),R4
		BIS	R4,MRNEW
		BIS	MRMR,(R0)+
		SOB	R3,5$
7$:		MOV	(SP)+,R3
		MOV	(SP)+,R2
		MOV	(SP)+,R1
		MOV	(SP)+,R0
		MOV	MRNEW,R4
		RETURN

; Push every dirty cell to the screen, one blit per run of set bits.
BLIT_MARKS:	CLR	BLROW
1$:		MOV	BLROW,R0
		ASL	R0
		ASL	R0
		ADD	#DIRTY,R0
		MOV	(R0),BLVAL
		CLR	(R0)+		; consume the row as it is blitted
		CLR	BLCOL
		CALL	BLIT_WORD
		MOV	BLROW,R0
		ASL	R0
		ASL	R0
		ADD	#DIRTY+2,R0
		MOV	(R0),BLVAL
		CLR	(R0)
		MOV	#16.,BLCOL
		CALL	BLIT_WORD
		INC	BLROW
		CMP	BLROW,#NROWS
		BLO	1$
		RETURN

; blit the runs of BLVAL's set bits as cells BLCOL.. of row BLROW
BLIT_WORD:	TST	BLVAL
		BEQ	9$
1$:		CLC			; ROR, not ASR: the sign bit of a
		ROR	BLVAL		; full row must shift out, not stick
		BCS	2$
		INC	BLCOL
		TST	BLVAL
		BNE	1$
		RETURN
2$:		MOV	#1,BLLEN	; measure the run
3$:		CLC
		ROR	BLVAL
		BCC	4$
		INC	BLLEN
		BR	3$
4$:		MOV	BLROW,R0
		MOV	BLCOL,R1
		MOV	BLLEN,R2
		CALL	BLIT_CELLS
		ADD	BLLEN,BLCOL
		INC	BLCOL		; the clear bit the run ended on
		TST	BLVAL
		BNE	1$
9$:		RETURN

; ---- randomness --------------------------------------------------
; The original reads the Z80's refresh register (0xAD36); the UKNC has
; nothing like it, so this is a 16-bit linear congruential generator,
; reset at the start of a game.  Clobbers R0 only, and returns a byte.
;
; It used to be a Galois LFSR stepped once per call, which was a
; mistake: one shift a call leaves consecutive bytes highly correlated,
; so anything that fires on "a random byte over a threshold" fired in
; bursts - the wall guns laid down an unbroken line of shots instead of
; the odd one.  Multiplying mixes the whole word every call, and the
; high byte of an LCG is the half worth using.
RNDMUL	= 25173.
RNDADD	= 13849.

RANDOM:		MOV	R1,RNDTMP
		MOV	RNDSEED,R1
		MUL	#RNDMUL,R1	; R1 is odd: just the low 16 bits
		ADD	#RNDADD,R1
		MOV	R1,RNDSEED
		MOV	R1,R0
		SWAB	R0
		BIC	#177400,R0
		MOV	RNDTMP,R1
		RETURN

; ---- score -------------------------------------------------------
; Six ASCII digits, added the way the original does it.
SCORE_CLEAR:	MOV	#SCORE,R0
		MOV	#6,R1
1$:		MOVB	#60,(R0)+
		SOB	R1,1$
		RETURN

; add the six-digit decimal amount at R3 (ASCII) to SCORE
SCORE_ADD:	MOV	#SCORE+5,R0
		ADD	#5,R3
		MOV	#6,R1
		CLR	R2		; carry
1$:		MOVB	@R0,R4
		BIC	#177400,R4
		MOVB	@R3,R5
		BIC	#177400,R5
		ADD	R5,R4
		SUB	#60,R4
		ADD	R2,R4
		CLR	R2
		CMP	R4,#71
		BLOS	2$
		SUB	#10.,R4
		MOV	#1,R2
2$:		MOVB	R4,@R0
		DEC	R0
		DEC	R3
		SOB	R1,1$
		MOV	#1,HUDDIRTY
		RETURN

SCORE_HIT:	MOV	#SC_HIT,R3
		CALL	SCORE_ADD
		RETURN

SCORE_ZONE:	MOV	#SC_ZONE,R3
		CALL	SCORE_ADD
		RETURN

SC_HIT:		.ASCII	/000030/
SC_ZONE:	.ASCII	/000100/
		.EVEN

; ---- game cycle --------------------------------------------------
GAME_START:	CLR	ZONE
		MOV	#8.,PXENT	; the first zone's classic start
		TST	ZSELON		; menu option 3: start from a chosen
		BEQ	1$		; zone instead of the first
		MOV	ZSEL,ZONE
		BEQ	1$
		CLR	PXENT		; any other zone begins at the very
					; left edge, as if walked into
1$:		MOV	#1,RNDSEED
		MOV	#7,LIVES
		MOV	#99.,AMMO
		MOV	#10.,GRENADES
		CLR	PSUIT
		CLR	GAMEOVER
		CLR	PAUSEREQ
		CLR	GATEPTR
		CALL	SCORE_CLEAR
		MOV	#96.,PYENT
		CALL	PLAYER_INIT
		MOV	#1,ZONELOAD
		RETURN

GAME_RUN:	CALL	GAME_START
1$:		CALL	VSYNC
		CALL	INPUT_READ
		MOV	#K_STOP,R0
		CALL	KEY_HELD
		BNE	9$
		MOV	#K_PAUSE,R0
		CALL	KEY_EDGE
		BEQ	3$
		CALL	PAUSE
3$:		TST	ZONELOAD
		BEQ	2$
		CALL	ZONE_LOAD
		CALL	PL_SNAP		; entry floors differ between zones
2$:		CALL	MARKS_CLEAR
		CLR	DRAWSKIP
20$:		CLR	DRAWOFF		; when the last frame overran its
		CMP	DRAWSKIP,#2	; tick, update with the sprites
		BHIS	23$		; undrawn and catch up - the game
		TST	VBLF		; keeps 50 Hz speed and the screen
		BEQ	23$		; drops to half or a third rate
		MOV	#1,DRAWOFF
		INC	DRAWSKIP
23$:		CALL	ENTS_ERASE
		CALL	FLY_ERASE
		CALL	PUMPS_ERASE
		CALL	PL_ERASE
		CALL	PLAYER_UPD
		CALL	GATE_CHECK	; the level gate freezes the game,
		BEQ	27$		; runs its bonus screens and leaves
		JMP	1$		; a zone load pending: restart
27$:		CALL	PL_SPECIAL
		CALL	SHOOT_BOLT
		CALL	THROW_GREN
		CALL	ENEMY_UPD
		CALL	ROCK_CHECK
		CALL	MINE_CHECK
		CALL	EMIT_CHECK
		CALL	FLY_SPAWN
		CALL	ENTS_UPD
		CALL	FLY_UPD
		CALL	PUMPS_UPD
		CALL	ANIMS_UPD
		CALL	PL_SHOW
		CALL	HUD_UPD
		INC	FRAMECNT
		INC	BENCHF
		TST	DRAWOFF
		BEQ	21$
		CALL	VSYNC		; the tick the extra pass consumed
		CALL	INPUT_READ
		MOV	#K_STOP,R0	; this read consumes the edges, so
		CALL	KEY_HELD	; СТОП and АР2 must be looked at
		BEQ	24$		; here as well - АР2 only takes
		BR	9$		; effect once the frame is drawn
24$:		MOV	#K_PAUSE,R0
		CALL	KEY_EDGE
		BEQ	25$
		MOV	#1,PAUSEREQ
25$:		BR	20$
21$:		CALL	BLIT_MARKS
		TST	PAUSEREQ
		BEQ	26$
		CLR	PAUSEREQ
		CALL	PAUSE
26$:		TST	GAMEOVER
		BEQ	1$
		CALL	SHOW_GAMEOVER
9$:		RETURN

; ------------------------------------------------------------------
; A display list stores the ZX ink (+1) in every cell it paints; the
; zone loader normally turns those into palette slots, but the title
; screen (and the gate's bonus screens) paint their logo afterwards,
; so convert them here.  Cells the text routines wrote already hold a
; slot (1..3) and are left alone.  INKCELLS does the first R1 cells
; through whatever ROWINK holds.
TITLE_INKS:	MOVB	#13.,ROWPAL3
		MOVB	#14.,ROWPAL3+1
		MOVB	#15.,ROWPAL3+2
		CALL	INK_MAP
		MOV	#15.*NCOLS,R1
INKCELLS:	MOV	#CELLS,R0
1$:		MOVB	C.SLOT(R0),R2
		BIC	#177400,R2
		CMP	R2,#3
		BLOS	2$
		DEC	R2
		MOVB	ROWINK(R2),R2
		MOVB	R2,C.SLOT(R0)
2$:		ADD	#C.SIZE,R0
		SOB	R1,1$
		RETURN

; ------------------------------------------------------------------
; АП2 holds the game still until it is pressed again.
PAUSE:		MOV	#11.,R0		; keep the cells the message covers
		MOV	#13.,R1
		CALL	CELLADDR
		MOV	#PAUSAVE,R3
		MOV	#12.,R4
5$:		MOV	(R2)+,(R3)+
		SOB	R4,5$
		MOV	#11.,R0
		MOV	#13.,R1
		MOV	#3,R2
		MOV	#S_PAUSED,R3
		CALL	PRINT_STR
		MOV	#11.,R0
		MOV	#13.,R1
		MOV	#6,R2
		MOV	#1,R3
		CALL	CELL_RECT
		MOV	#11.,R0
		MOV	#13.,R1
		MOV	#6,R2
		MOV	#1,R3
		CALL	BLIT_RECT
1$:		CALL	VSYNC
		CALL	INPUT_READ
		MOV	#K_PAUSE,R0
		CALL	KEY_EDGE
		BEQ	1$
		MOV	#11.,R0		; put the cells back
		MOV	#13.,R1
		CALL	CELLADDR
		MOV	#PAUSAVE,R3
		MOV	#12.,R4
2$:		MOV	(R3)+,(R2)+
		SOB	R4,2$
		MOV	#11.,R0
		MOV	#13.,R1
		MOV	#6,R2
		MOV	#1,R3
		CALL	CELL_RECT
		MOV	#11.,R0
		MOV	#13.,R1
		MOV	#6,R2
		MOV	#1,R3
		CALL	BLIT_RECT
		RETURN

; ------------------------------------------------------------------
; Wait for the next 50 Hz tick (the ISR shifts a bit into VBLF).
VSYNC:		TST	VBLF
		BEQ	VSYNC
		ASR	VBLF
		RETURN

; ------------------------------------------------------------------
SHOW_GAMEOVER:	MOV	#10.,R0
		MOV	#11.,R1
		MOV	#3,R2
		MOV	#S_GAMEOVER,R3
		CALL	PRINT_STR
		MOV	#10.,R0
		MOV	#11.,R1
		MOV	#10.,R2
		MOV	#1,R3
		CALL	CELL_RECT
		MOV	#10.,R0
		MOV	#11.,R1
		MOV	#10.,R2
		MOV	#1,R3
		CALL	BLIT_RECT
		MOV	#150.,R5
1$:		CALL	VSYNC
		SOB	R5,1$
		RETURN

; ------------------------------------------------------------------
; The title screen: the game's own logo zone plus the menu text.
MENU:		MOV	#124.,ZONE	; the last zone doubles as a backdrop
		CLR	PX
		MOV	#128.,PY
		CALL	ENTS_CLEAR
		CALL	ZONE_LOAD
		MOV	#CELLS+<22.*C.ROW>,R0	; no status panel on the title
		MOV	#NCOLS*2,R1
1$:		CLR	(R0)+
		CLR	(R0)+
		SOB	R1,1$
		MOV	#CELLS,R0		; clear the sky the title sits on
		MOV	#15.*NCOLS,R1
3$:		CLR	(R0)+
		CLR	(R0)+
		SOB	R1,3$
		CLR	R5			; and give those rows their own
4$:		MOVB	#13.,ROWPAL3		; palette: cyan, yellow, white
		MOVB	#14.,ROWPAL3+1
		MOVB	#15.,ROWPAL3+2
		MOV	R5,R0
		CALL	ROW_PALWORDS
		MOVB	#3,WHITESL(R5)
		INC	R5
		CMP	R5,#15.
		BLO	4$
		MOV	#2,R0
		CALL	SEND_PP_COMM
		MOV	#L_LOGO,R0		; the original's own EXOLON logo
		CLR	R1
		MOV	#8.,R2
		CALL	RUN_LIST
		CALL	TITLE_INKS
		MOV	#6,R0		; the menu: two credit lines and the
		MOV	#7,R1		; original's own two numbered options
		MOV	#2,R2
		MOV	#S_AUTHOR,R3
		CALL	PRINT_STR
		MOV	#8.,R0
		MOV	#11.,R1
		MOV	#1,R2
		MOV	#S_PORT,R3
		CALL	PRINT_STR
		MOV	#10.,R0
		MOV	#6,R1
		MOV	#3,R2
		MOV	#S_START,R3
		CALL	PRINT_STR
		MOV	#CH_ROW,R0
		MOV	#6,R1
		MOV	#3,R2
		MOV	#S_LIVESOPT,R3
		CALL	PRINT_STR
		CALL	MENU_CHEAT
		MOV	#ZS_ROW,R0	; option 3: start from a chosen zone,
		MOV	#6,R1		; picked with up / down while it is on
		MOV	#3,R2
		MOV	#S_ZONEOPT,R3
		CALL	PRINT_STR
		CALL	MENU_ZOPT
		MOV	#14.,R0
		MOV	#10.,R1
		MOV	#2,R2
		MOV	#S_COPY,R3
		CALL	PRINT_STR
		CLR	R0
		CLR	R1
		MOV	#NCOLS,R2
		MOV	#NROWS,R3
		CALL	CELL_RECT
		CALL	BLIT_FULL
		MOV	#1,SND_MODE	; the title tune plays in the PPU
2$:		CALL	VSYNC
		CALL	INPUT_READ
		MOV	#K_2,R0		; '2' toggles infinite lives
		CALL	KEY_EDGE
		BEQ	5$
		MOV	#1,R0
		XOR	R0,CHEAT
		CALL	MENU_CHEAT
		CALL	MENU_SHOWCH
5$:		MOV	#K_3,R0		; '3' toggles the starting-zone pick
		CALL	KEY_EDGE
		BEQ	6$
		MOV	#1,R0
		XOR	R0,ZSELON
		CALL	MENU_ZSHOW
6$:		TST	ZSELON		; up / down pick the zone while it is on
		BEQ	7$
		MOV	#K_UP,R0
		CALL	KEY_EDGE
		BEQ	62$
		INC	ZSEL
		CMP	ZSEL,#125.
		BLO	61$
		CLR	ZSEL
61$:		CALL	MENU_ZSHOW
62$:		MOV	#K_DOWN,R0
		CALL	KEY_EDGE
		BEQ	7$
		DEC	ZSEL
		BGE	63$
		MOV	#124.,ZSEL
63$:		CALL	MENU_ZSHOW
7$:		MOV	#K_1,R0		; '1' starts, as the menu says
		CALL	KEY_EDGE
		BEQ	2$
		CLR	SND_MODE
		RETURN

; ------------------------------------------------------------------
; The state of menu options 2 and 3, at the end of their lines.
; Written into the cell buffer only - MENU expands and blits the whole
; screen after the first call, and MENU_SHOWCH / MENU_ZSHOW do the few
; changed cells after a toggle.
CH_ROW	= 11.
CH_COL	= 23.
ZS_ROW	= 12.
ZS_COL	= 24.

ZSELON:		.WORD	0	; option 3 armed
ZSEL:		.WORD	0	; the zone a game will then start in

MENU_CHEAT:	MOV	#CH_COL,MENUC	; blank it first: ON is shorter than
1$:		MOV	#CH_ROW,R0	; OFF, and CELL_SET keeps no registers
		MOV	MENUC,R1
		CLR	R2
		CLR	R4		; an empty cell
		CALL	CELL_SET
		INC	MENUC
		CMP	MENUC,#CH_COL+3
		BLO	1$
		MOV	#S_OFF,R3
		TST	CHEAT
		BEQ	2$
		MOV	#S_ON,R3
2$:		MOV	#CH_ROW,R0
		MOV	#CH_COL,R1
		MOV	#2,R2
		CALL	PRINT_STR
		RETURN

MENU_SHOWCH:	MOV	#CH_ROW,R0
		MOV	#CH_COL,R1
		MOV	#3,R2
		MOV	#1,R3
		CALL	CELL_RECT
		MOV	#CH_ROW,R0
		MOV	#CH_COL,R1
		MOV	#3,R2
		MOV	#1,R3
		CALL	BLIT_RECT
		RETURN

; ------------------------------------------------------------------
; Option 3's state cells: OFF, or the chosen zone as three digits.
MENU_ZOPT:	MOV	#ZS_COL,MENUC	; blank the three cells first
1$:		MOV	#ZS_ROW,R0
		MOV	MENUC,R1
		CLR	R2
		CLR	R4
		CALL	CELL_SET
		INC	MENUC
		CMP	MENUC,#ZS_COL+3
		BLO	1$
		TST	ZSELON
		BNE	2$
		MOV	#ZS_ROW,R0
		MOV	#ZS_COL,R1
		MOV	#2,R2
		MOV	#S_OFF,R3
		CALL	PRINT_STR
		RETURN
2$:		MOV	ZSEL,R4		; three digits, HUD style
		MOV	#ZS_COL+2,MENUC
3$:		MOV	R4,R0		; R0 = R4 % 10, R4 /= 10
		CLR	R4
4$:		SUB	#10.,R0
		BLT	5$
		INC	R4
		BR	4$
5$:		ADD	#10.+60,R0
		MOV	R4,-(SP)
		MOV	R0,R4
		MOV	#ZS_ROW,R0
		MOV	MENUC,R1
		MOV	#2,R2
		CALL	CELL_SET
		MOV	(SP)+,R4
		DEC	MENUC
		CMP	MENUC,#ZS_COL
		BGE	3$
		RETURN

MENU_ZSHOW:	CALL	MENU_ZOPT
		MOV	#ZS_ROW,R0
		MOV	#ZS_COL,R1
		MOV	#3,R2
		MOV	#1,R3
		CALL	CELL_RECT
		MOV	#ZS_ROW,R0
		MOV	#ZS_COL,R1
		MOV	#3,R2
		MOV	#1,R3
		CALL	BLIT_RECT
		RETURN
