; ------------------------------------------------------------------
; Drawing primitives.
;
; Everything is composed in the back buffer (BUF: 192 lines x 32 cell
; words, low byte = plane 1, high byte = plane 2) and pushed to the
; screen through @#176640 (plane byte address) / @#176642 (both plane
; bytes as one word).  A cell is 8 double-wide pixels, so one word per
; cell per line and one plane byte address per cell.
;
; Colour lives in the cell buffer as a slot 1..3: slot 1 lights plane
; 1, slot 2 plane 2, slot 3 both, and the row's palette element maps
; the resulting pixel values 2/4/6 to three inks (see zone.mac).
; Sprites are drawn white (slot 3) over the expanded background, and
; erased by re-expanding the cells they covered.
; ------------------------------------------------------------------

; ------------------------------------------------------------------
; R0 = cell row, R1 = cell column -> R2 = cell record address.
; Preserves R0, R1.
CELLADDR:	MOV	R0,R2
		ASL	R2
		ASL	R2
		ASL	R2
		ASL	R2
		ASL	R2
		ASL	R2
		ASL	R2		; row*128 = row*C.ROW
		MOV	R1,-(SP)
		ASL	@SP
		ASL	@SP		; col*4
		ADD	(SP)+,R2
		ADD	#CELLS,R2
		RETURN

; ------------------------------------------------------------------
; R0 = cell row, R1 = cell column -> R3 = back buffer address of the
; cell's top line.  Preserves R0, R1.
BUFADDR:	MOV	R0,R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3		; row*512 = row*BUF_CELLROW
		MOV	R1,-(SP)
		ASL	@SP
		ADD	(SP)+,R3
		ADD	#BUF,R3
		RETURN

; ------------------------------------------------------------------
; R0 = cell row, R1 = cell column -> R3 = video plane byte address.
; Preserves R0, R1.
VIDADDR:	MOV	R0,R3
		ASL	R3
		ASL	R3		; row*4
		MOV	R3,-(SP)
		ASL	R3
		ASL	R3		; row*16
		ADD	(SP)+,R3	; row*20
		ASL	R3		; a cell row is 8 lines of 80 bytes,
		ASL	R3		; so row*640 = row*20*32
		ASL	R3
		ASL	R3
		ASL	R3
		ADD	R1,R3
		ADD	#VCELL0,R3
		RETURN

; ------------------------------------------------------------------
; Expand one cell of the cell buffer into the back buffer.
; R0 = cell row, R1 = cell column.  Preserves R0, R1.
CELL_DRAW:	MOV	R0,-(SP)
		MOV	R1,-(SP)
		CALL	CELLADDR	; R2 = cell record
		CALL	BUFADDR		; R3 = buffer
		CALL	CELL_ONE
		MOV	(SP)+,R1
		MOV	(SP)+,R0
		RETURN

; The same with the two addresses already worked out: R2 = the cell
; record, R3 = its top line in the back buffer.  Clobbers everything.
; CELL_RECT walks both pointers itself, because the shifts CELLADDR and
; BUFADDR need cost as much again as expanding the cell does.
CELL_ONE:	MOVB	C.SLOT(R2),R0
		BIC	#177400,R0
		MOV	@R2,R5		; tile index
		ASL	R5
		ASL	R5
		ASL	R5		; *8
		ADD	#TILE_GFX,R5
		MOV	#8.,R2
		DEC	R0
		BEQ	CD_P1
		DEC	R0
		BEQ	CD_P2
		DEC	R0
		BEQ	CD_P3
CD_CLR:		CLR	(R3)		; empty cell
		ADD	#BUF_ROW,R3
		SOB	R2,CD_CLR
		BR	CD_END
CD_P1:		MOVB	(R5)+,R1	; plane 1 only
		BIC	#177400,R1
		MOV	R1,(R3)
		ADD	#BUF_ROW,R3
		SOB	R2,CD_P1
		BR	CD_END
CD_P2:		MOVB	(R5)+,R1	; plane 2 only
		BIC	#177400,R1
		SWAB	R1
		MOV	R1,(R3)
		ADD	#BUF_ROW,R3
		SOB	R2,CD_P2
		BR	CD_END
CD_P3:		MOVB	(R5)+,R1	; both planes, through the same
		BIC	#177400,R1	; table the sprite loop uses
		ASL	R1
		MOV	DUPTAB(R1),(R3)
		ADD	#BUF_ROW,R3
		SOB	R2,CD_P3
CD_END:		RETURN

; ------------------------------------------------------------------
; Clip a rectangle to the screen.  R0 = row, R1 = col, R2 = width,
; R3 = height; returns the clipped values, Z set when nothing is left.
CLIPRECT:	TST	R0
		BGE	1$
		ADD	R0,R3		; drop the rows above the screen
		CLR	R0
1$:		TST	R1
		BGE	2$
		ADD	R1,R2
		CLR	R1
2$:		MOV	R1,R4
		ADD	R2,R4
		CMP	R4,#NCOLS
		BLOS	3$
		MOV	#NCOLS,R2
		SUB	R1,R2
3$:		MOV	R0,R4
		ADD	R3,R4
		CMP	R4,#NROWS
		BLOS	4$
		MOV	#NROWS,R3
		SUB	R0,R3
4$:		TST	R2
		BLE	8$
		TST	R3
		BLE	8$
		CMP	R0,#NROWS
		BHIS	8$
		CMP	R1,#NCOLS
		BHIS	8$
		TST	R2		; clear Z: something to draw
		RETURN
8$:		CLR	R2
		CLR	R3
		RETURN

; ------------------------------------------------------------------
; Expand a rectangle of cells: R0 = row, R1 = col, R2 = width,
; R3 = height.  Clobbers everything.
CELL_RECT:	CALL	CLIPRECT
		BEQ	9$
		MOV	R3,CRH
		MOV	R2,CRW0
		CALL	CELLADDR	; R2 = first cell record
		MOV	R2,CRC0
		CALL	BUFADDR		; R3 = its top buffer line
		MOV	R3,CRB0
1$:		MOV	CRC0,CRC
		MOV	CRB0,CRB
		MOV	CRW0,CRW
2$:		MOV	CRC,R2
		MOV	CRB,R3
		CALL	CELL_ONE
		ADD	#C.SIZE,CRC
		ADD	#2,CRB
		DEC	CRW
		BNE	2$
		ADD	#C.ROW,CRC0
		ADD	#BUF_CELLROW,CRB0
		DEC	CRH
		BNE	1$
9$:		RETURN

EXPAND_ALL:	CLR	R0
		CLR	R1
		MOV	#NCOLS,R2
		MOV	#NROWS,R3
		CALL	CELL_RECT
		RETURN

; ------------------------------------------------------------------
; Blit R2 cells of cell row R0 starting at column R1 (8 lines).
; Clobbers R0..R5.
BLIT_CELLS:	MOV	R2,-(SP)
		CALL	BUFADDR		; R3 = buffer
		MOV	R3,R2
		CALL	VIDADDR		; R3 = video
		MOV	(SP)+,R1
		MOV	#176640,R4
		MOV	#176642,R5
		MOV	#8.,-(SP)	; lines
1$:		MOV	R1,-(SP)
		MOV	R2,-(SP)
		MOV	R3,R0		; the address advances in a register:
2$:		MOV	R0,@R4		; writing it costs one I/O access
		INC	R0		; where INCing the register cost two
		MOV	(R2)+,@R5
		SOB	R1,2$
		MOV	(SP)+,R2
		MOV	(SP)+,R1
		ADD	#BUF_ROW,R2
		ADD	#VLINE,R3
		DEC	@SP
		BNE	1$
		TST	(SP)+
		RETURN

; ------------------------------------------------------------------
; Blit a rectangle of cells: R0 = row, R1 = col, R2 = width,
; R3 = height.  Clobbers everything.
BLIT_RECT:	CALL	CLIPRECT
		BEQ	9$
		MOV	R3,-(SP)
		MOV	R2,-(SP)
		MOV	R1,-(SP)
1$:		MOV	@SP,R1
		MOV	2(SP),R2
		MOV	R0,-(SP)
		CALL	BLIT_CELLS
		MOV	(SP)+,R0
		INC	R0
		DEC	4(SP)
		BNE	1$
		CMP	(SP)+,(SP)+
		TST	(SP)+
9$:		RETURN

BLIT_FULL:	CLR	R0
		CLR	R1
		MOV	#NCOLS,R2
		MOV	#NROWS,R3
		CALL	BLIT_RECT
		RETURN

; ------------------------------------------------------------------
; Sprite drawing.  Sprites are 1bpp with UKNC bit order (bit 0 is the
; leftmost pixel), so moving right is a left shift.  X is in 2-pixel
; units: the low two bits pick one of four sub-cell shifts (0/2/4/6
; pixels), the rest is the cell column.  A 3-byte-wide frame therefore
; covers four cell columns.
;
; The original never turns Vitorc round - the sheet holds one facing and
; the plotter at 0x76DA has no mirror path - but the UKNC port does, so a
; frame drawn with SPRMIR set has each line's 24 pixels reversed: the
; three source bytes swap ends and each one's bits are reversed through
; REVTAB.  SPR_SMALL always draws straight (the 16x16 bank carries both
; facings of everything that has one).
; The inner loop runs once per pixel line of every sprite on screen, so
; it keeps the destination, the source and the line count in registers,
; recomputes the row's plane mask only when it crosses a cell row, and
; expands a source byte into a cell word through DUPTAB rather than a
; SWAB-and-merge.  Anything that costs a memory reference here costs it
; a few thousand times a frame.
REV_INIT:	CLR	R0
1$:		MOV	R0,R1		; REVTAB: the byte with its bits
		CLR	R2		; reversed
		MOV	#8.,R3
2$:		ASR	R1
		ROL	R2
		SOB	R3,2$
		MOVB	R2,REVTAB(R0)
		MOV	R0,R1		; DUPTAB: the byte in both halves of a
		MOV	R0,R2		; word, which is one pixel row of a
		SWAB	R2		; sprite cell lighting both planes
		BIS	R2,R1
		ASL	R0
		MOV	R1,DUPTAB(R0)
		ASR	R0
		INC	R0
		CMP	R0,#256.
		BLO	1$
		RETURN

; SPR_PLAYER: R0 = frame, R1 = x (2-px units), R2 = y (pixels).  The
; player fills his frame, so he clears the extents the entity kinds set.
; SPR_PLAYERH draws only the top SPRH lines of the frame (0 = all 32) -
; the rising pumps use it to stop at the ground line.
SPR_PLAYER:	CLR	SPRH
SPR_PLAYERH:	CLR	SPRC
		MOV	R0,R4
		ASL	R4
		ASL	R4
		ASL	R4
		ASL	R4
		ASL	R4		; frame*32
		MOV	R4,R3
		ASL	R3		; frame*64
		ADD	R3,R4		; frame*96
		ADD	#PLAYER_SPR,R4
		MOV	R4,SPRSRC
		MOV	SPRH,R5
		BNE	1$
		MOV	#32.,R5
1$:		MOV	#3,TMPA		; source bytes per line
		BR	SPR_GO

; SPR_SMALL: R0 = frame, R1 = x, R2 = y.  2 bytes x 16 lines, of which
; SPRH are actually drawn - most of the frames this port added to the
; sheet are eight lines tall, and drawing the blank half of one costs as
; much as drawing the half that shows.
SPR_SMALL:	MOV	R0,R4
		ASL	R4
		ASL	R4
		ASL	R4
		ASL	R4
		ASL	R4		; frame*32
		ADD	#SMALL_SPR,R4
		MOV	R4,SPRSRC
		MOV	SPRH,R5
		BNE	1$
		MOV	#16.,R5
1$:		MOV	#2,TMPA

SPR_GO:		TST	DRAWOFF		; a catch-up pass draws nothing -
		BEQ	32$		; the blitted frame after it does
		RETURN
32$:		MOV	R1,R3		; shift = (x & 3) * 2
		BIC	#177774,R3
		ASL	R3
		MOV	R3,SPRSHIFT
		ASR	R1
		ASR	R1		; cell column
		MOV	#NCOLS,R3	; cells we may touch
		SUB	R1,R3
		MOV	TMPA,R4
		TST	SPRSHIFT	; aligned: the extra cell the shift
		BEQ	31$		; could spill into is never lit
		INC	R4		; width in cells = bytes + 1
31$:		CMP	R3,R4
		BLOS	1$
		MOV	R4,R3
1$:		MOV	R3,TMPB		; cells to write per line
		BGT	SPR_GO1
		JMP	SPR_DONE
SPR_GO1:	MOV	SPRC,R3		; an eight-pixel frame never reaches
		BEQ	SPR_GO2		; past the second cell, whatever the
		CMP	TMPB,R3		; sub-cell shift, and testing the two
		BLOS	SPR_GO2		; it cannot reach costs as much as
		MOV	R3,TMPB		; drawing them
SPR_GO2:	MOV	R2,SPRY
		MOV	R2,R3		; dst = BUF + y*64 + col*2
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		MOV	R1,R4
		ASL	R4
		ADD	R4,R3
		ADD	#BUF,R3
		CALL	SPR_SETNOT
		MOV	SPRSRC,R4

; R3 = destination line, R4 = source, R5 = lines left
SPR_LINE:	CMP	R3,#BUF
		BLO	SPR_SKIP
		CMP	R3,#BUF_END
		BHIS	SPR_DONE
		MOVB	(R4)+,R0
		BIC	#177400,R0
		MOVB	(R4)+,R1
		BIC	#177400,R1
		SWAB	R1
		BIS	R1,R0		; R0 = source bytes 0 and 1
		CLR	R1
		CMP	TMPA,#3
		BNE	1$
		MOVB	(R4)+,R1	; R1 = source byte 2
		BIC	#177400,R1
1$:		TST	R0		; a blank line costs nothing more
		BNE	11$		; than these tests (explosion and
		TST	R1		; spark frames are half empty)
		BNE	11$
		JMP	SPR_NEXT
11$:		TST	SPRMIR
		BEQ	2$
		CALL	SPR_FLIP
2$:		MOV	SPRSHIFT,R2	; slide it into place
		BEQ	4$
3$:		ASL	R0
		ROL	R1
		SOB	R2,3$

4$:		MOV	R0,R2		; cell 0
		BIC	#177400,R2
		BEQ	5$
		ASL	R2
		MOV	DUPTAB(R2),R2
		BIC	SPRNOT,R2
		BIS	R2,(R3)
5$:		CMP	TMPB,#1
		BLE	SPR_NEXT
		MOV	R0,R2		; cell 1
		SWAB	R2
		BIC	#177400,R2
		BEQ	6$
		ASL	R2
		MOV	DUPTAB(R2),R2
		BIC	SPRNOT,R2
		BIS	R2,2(R3)
6$:		CMP	TMPB,#2
		BLE	SPR_NEXT
		MOV	R1,R2		; cell 2
		BIC	#177400,R2
		BEQ	7$
		ASL	R2
		MOV	DUPTAB(R2),R2
		BIC	SPRNOT,R2
		BIS	R2,4(R3)
7$:		CMP	TMPB,#3
		BLE	SPR_NEXT
		MOV	R1,R2		; cell 3
		SWAB	R2
		BIC	#177400,R2
		BEQ	SPR_NEXT
		ASL	R2
		MOV	DUPTAB(R2),R2
		BIC	SPRNOT,R2
		BIS	R2,6(R3)

SPR_NEXT:	ADD	#BUF_ROW,R3
		INC	SPRY
		MOV	SPRY,R2		; a new cell row picks a new plane mask
		BIC	#177770,R2
		BNE	8$
		CALL	SPR_SETNOT
8$:		DEC	R5
		BNE	SPR_LINE
SPR_DONE:	RETURN

SPR_SKIP:	ADD	TMPA,R4		; line above the buffer: skip its source
		BR	SPR_NEXT

; The planes the sprite must not light in cell row SPRY>>3: sprites are
; drawn in the slot whose ink is nearest white (zone.mac WHITESL), and
; slots 1 and 2 are one plane each.  Clobbers R0 and R2.
SPR_SETNOT:	MOV	SPRY,R0
		ASR	R0
		ASR	R0
		ASR	R0
		CMP	R0,#NROWS
		BHIS	9$
		MOVB	WHITESL(R0),R0
		BIC	#177774,R0
		ASL	R0
		MOV	SLOTNOT(R0),SPRNOT
		RETURN
9$:		CLR	SPRNOT
		RETURN

SLOTNOT:	.WORD	0,177400,377,0	; slot -> planes to suppress

; Mirror one line across the frame's own width: the outer bytes swap
; ends and every byte has its bits reversed.  R0 = bytes 0 and 1,
; R1 = byte 2 (zero for the 16-pixel frames).
SPR_FLIP:	MOV	R0,R2
		BIC	#177400,R2	; byte 0
		MOVB	REVTAB(R2),R2
		BIC	#177400,R2
		MOV	R2,SPRB0
		MOV	R0,R2
		SWAB	R2
		BIC	#177400,R2	; byte 1
		MOVB	REVTAB(R2),R2
		BIC	#177400,R2
		CMP	TMPA,#3
		BEQ	1$
		SWAB	SPRB0		; 16 pixels: the two bytes swap
		BIS	SPRB0,R2
		MOV	R2,R0
		CLR	R1
		RETURN
1$:		SWAB	R2		; 24: byte 1 stays in the middle
		MOVB	REVTAB(R1),R0	; byte 2 -> the new byte 0
		BIC	#177400,R0
		BIS	R2,R0
		MOV	SPRB0,R1	; byte 0 -> the new byte 2
		RETURN

; ------------------------------------------------------------------
; A single pixel, for the laser bolts and the gun emplacements' shots.
; The original draws those as a short pattern XORed onto the screen at
; two-pixel resolution; here x is already in 2-pixel units, so one unit
; is one pair of bits in the cell word and the dot is as small as the
; screen can show.  R1 = x (2-pixel units), R2 = y (pixels).
; The row's sprite slot picks the colour, exactly as for a sprite.
PIXW:		.WORD	401,2004,10020,40100	; bit pair, both planes

PIX_DRAW:	TST	DRAWOFF
		BNE	9$
		CMP	R2,#192.
		BHIS	9$
		CMP	R1,#128.
		BHIS	9$
		MOV	R2,R0
		ASR	R0
		ASR	R0
		ASR	R0		; cell row
		MOVB	WHITESL(R0),R0
		BIC	#177774,R0
		ASL	R0
		MOV	SLOTNOT(R0),R5
		MOV	R1,R0
		BIC	#177774,R0
		ASL	R0
		MOV	PIXW(R0),R4
		BIC	R5,R4
		BEQ	9$
		MOV	R2,R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3
		ASL	R3		; y * BUF_ROW
		MOV	R1,R0
		ASR	R0
		ASR	R0
		ASL	R0		; column word
		ADD	R0,R3
		ADD	#BUF,R3
		BIS	R4,(R3)
9$:		RETURN

; ------------------------------------------------------------------
; Text into the cell buffer: R3 = 0-terminated string (tile codes),
; R0 = cell row, R1 = cell column, R2 = ink slot.
PRINT_STR:	MOVB	(R3)+,R4
		BEQ	9$
		BIC	#177400,R4
		MOV	R3,-(SP)
		MOV	R2,-(SP)
		MOV	R1,-(SP)
		MOV	R0,-(SP)
		CALL	CELL_SET
		MOV	(SP)+,R0
		MOV	(SP)+,R1
		MOV	(SP)+,R2
		MOV	(SP)+,R3
		INC	R1
		BR	PRINT_STR
9$:		RETURN

; Put tile R4 with slot R2 into cell (R0, R1) of the cell buffer.
; Clobbers R2, R3, R5.
CELL_SET:	CMP	R1,#NCOLS
		BHIS	9$
		CMP	R0,#NROWS
		BHIS	9$
		MOV	R2,R5
		MOV	R4,R3
		CALL	CELLADDR	; R2 = cell record
		MOV	R3,@R2
		MOVB	R5,C.SLOT(R2)
		CLRB	C.SOLID(R2)
9$:		RETURN
