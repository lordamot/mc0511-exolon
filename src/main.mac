; ------------------------------------------------------------------
; Startup: install the vsync ISR, load the PPU program, then loop
; between the title screen and a game.  Follows straight on from the
; boot sector's jump at 1000 - nothing pads the gap.
; ------------------------------------------------------------------
MAIN_START:	MOV	#STACK_TOP,SP
		MOV	#INTERR_MAIN,@#100
		MOV	#TRAP_RTI,@#4	; stray traps: ignore
		MOV	#TRAP_RTI,@#10
		CLR	KEYS_DATA
		CLR	CPU_VSYNC
		CLR	SND_REQ
		CLR	SND_MODE
		CLR	SND_DEV		; the beeper until the menu says otherwise
		CLR	VBLF
		CLR	KEYS
		CLR	KEYPREV
		MOV	#1,RNDSEED
		CLR	CHEAT
		CLR	PALORD		; the palette order PALNIB starts on
		CLR	ROCKACT
		CLR	LERASE		; list state is uninitialised RAM
		CLR	BENCHF
		CALL	MARKS_CLEAR
		CALL	PP_MAIN_LOAD	; PPU: line table, colours, sound
		CALL	REV_INIT	; byte -> reversed bits, for facing
					; left - built into the CPU-side PPU
					; block, dead once the load is done

MAIN_CYCLE:	CALL	MENU
		CALL	GAME_RUN
		BR	MAIN_CYCLE

TRAP_RTI:	RTI

; 50 Hz vsync ISR: frame bits and the free-running counter
INTERR_MAIN:	MOV	R0,-(SP)
		ASL	VBLF		; one more frame pending
		INC	VBLF
		BIC	#177770,VBLF	; at most 3 pending: a long stall
					; must not shift bits into the sign
		INC	TICK
		MOV	(SP)+,R0
		RTI
