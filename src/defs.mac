		.ASECT
; ------------------------------------------------------------------
; Global layout constants (octal).  See .claude/docs/port-plan.md.
; ------------------------------------------------------------------

PROG_SIZE = 110000		; program image size (boot + code + data)

; back buffer: 192 lines x 32 cells, one word per cell
; (low byte = plane 1, high byte = plane 2)
BUF	= 110000		; 110000..137777 (12288 bytes)
BUF_END	= 140000
BUF_ROW	= 100			; 64. bytes per pixel line
BUF_CELLROW = 1000		; 8 lines of a cell row

; visible screen (plane byte addresses for @#176640)
VRAM	= 100000		; first visible line
VLINE	= 120			; 80. plane bytes per line (320 mode shows 40)
VX0	= 4			; game area left margin, bytes
VY0	= 60			; 48. lines top margin
VCELL0	= VRAM + <48.*80.> + VX0	; video address of cell (0,0)

; cell buffer: 24 rows x 32 columns x 4 bytes
;   +0 tile index (word)
;   +2 ink slot 0..3 (0 = empty cell, 1..3 = row palette entry)
;   +3 collision class from the display list
CELLS	= 140000		; 140000..145777 (3072 bytes)
C.TILE	= 0
C.SLOT	= 2
C.SOLID	= 3
C.SIZE	= 4
C.ROW	= 200			; 32 cells x 4 bytes = 128.

NROWS	= 24.
NCOLS	= 32.
PLAYROWS = 22.			; rows 0..21 are the zone, 22..23 the HUD

STACK_TOP = 157000		; user RAM ends at 157777 on the UKNC

; ---- entity record (bullets, enemy shots, sprites) ---------------
E.STATE	= 0.		; 0 = free
E.X	= 1.		; x in 2-pixel units
E.Y	= 2.		; y in pixels
E.KIND	= 3.		; behaviour selector
E.T1	= 4.		; per-kind counters
E.T2	= 5.
E.SIZE	= 6.
NENT	= 24.		; entity slots

; ---- live scenery object (built from the zone data) --------------
O.X0	= 0.		; bounding box, x in 2-pixel units
O.X1	= 1.
O.Y0	= 2.		; y in pixels
O.Y1	= 3.
O.COL	= 4.		; cell position
O.ROW	= 5.
O.OBJ	= 6.		; object id (behaviour)
O.T	= 7.		; per-object timer
O.SIZE	= 8.
NOBJ	= 20.		; live objects per zone

; ---- object ids that behave ---------------------------------------
OB_CANNON = 5.		; ground cannon: fires along the player's row
OB_ROCK	= 13.		; indestructible rock
OB_DISH	= 15.		; radar dish
OB_ROCKET = 16.		; rocket bank: launches upwards
OB_AMMO	= 18.		; ammunition canister
OB_AMMO2 = 19.
OB_GREN	= 20.		; grenade canister
OB_FIELD = 21.		; force-field emitter
OB_MINE	= 31.		; hovering mine
OB_HOPPER = 40.		; hopper (spits at the player)
OB_GUN	= 44.		; small gun emplacement
OB_TREE	= 46.		; energy tree

; ---- sound requests (SND_REQ) ------------------------------------
SFX_SHOT = 1
SFX_BOOM = 2
SFX_PICK = 3
SFX_DIE	= 4
SFX_STEP = 5
SFX_ZONE = 6
