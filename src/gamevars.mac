; ------------------------------------------------------------------
; Uninitialised RAM: the PPU mailbox, game variables and the entity
; lists.  Placed above the cell buffer - nothing here emits bytes, so
; the code must initialise whatever it uses.  This module assembles
; before the code (every label is then known everywhere) and returns
; the location counter to 0 for boot.mac at the end.
; ------------------------------------------------------------------
		. = 153000

; PPU mailbox (written by the PPU program through @#177010/177014).
; CPU_VSYNC must directly follow KEYS_DATA - the PPU timer writes them
; back to back.
KEYS_DATA:	.BLKW	1	; key state word from the PPU
CPU_VSYNC:	.BLKW	1	; nonzero once per 50 Hz tick
SND_REQ:	.BLKW	1	; sound request (SFX_* in defs.mac)
SND_MODE:	.BLKW	1	; nonzero = play the title tune
ROWPALS:	.BLKW	48.	; 24 x 2 palette words (PPU COMMAND_2)

; ---- frame / input ----------------------------------------------
VBLF:		.BLKW	1	; vsync bits (ISR shifts in, loop consumes)
BENCHF:		.BLKW	1	; game frames since power-up: never reset,
				; so headless scripts can measure frame rate
FRAMECNT:	.BLKW	1	; frames since the zone was loaded
TICK:		.BLKW	1	; free-running tick
KEYS:		.BLKW	1	; debounced key word for this frame
KEYPREV:	.BLKW	1

; ---- zone -------------------------------------------------------
RNDSEED:	.BLKW	1	; 16-bit LFSR behind RANDOM
ROCKACT:	.BLKW	1	; the lingering-player rocket is in the air
ZONE:		.BLKW	1	; current zone 0..124
ZONELOAD:	.BLKW	1	; nonzero = (re)load the zone this frame
NLIVE:		.BLKW	1	; live scenery objects in OBJLIST
ROWINK:		.BLKB	16.	; ink -> slot map while a row is converted
ROWCNT:		.BLKW	16.	; ink pixel weights for the current row
ROWPAL3:	.BLKB	4	; the three inks chosen for the row
WHITESL:	.BLKB	24.	; per row: the slot whose ink is nearest white
PALORD:		.BLKW	1	; palette colour order: 0 = RGB, 1 = GRB
ROWINKS:	.BLKB	3*24.	; per row: the three inks its palette shows,
		.EVEN		; kept so PAL_SETORD can re-encode them
ROWW3:		.BLKW	3	; pixel weight of each chosen ink
ROWWTOT:	.BLKW	1	; total lit pixels in the row
		.EVEN

; ---- player -----------------------------------------------------
PX:		.BLKW	1	; x in 2-pixel units (0..127)
PY:		.BLKW	1	; y in pixels, top of the 32-line sprite
PXENT:		.BLKW	1	; zone entry position (respawn)
PYENT:		.BLKW	1
PFACE:		.BLKW	1	; +1 right, -1 left
PJUMP:		.BLKW	1	; jump arc counter, 0 = on the ground
PWALK:		.BLKW	1	; walk animation counter 0..9
PDUCK:		.BLKW	1
PSUIT:		.BLKW	1	; power-suit frame offset (0 or 12.)
PDEAD:		.BLKW	1	; death animation counter
PFALL:		.BLKW	1	; free fall
PFRAME:		.BLKW	1	; frame drawn last time
POLDX:		.BLKW	1	; where the sprite was drawn last frame
POLDY:		.BLKW	1
POLDF:		.BLKW	1

; ---- score / status ---------------------------------------------
CHEAT:		.BLKW	1	; nonzero = infinite lives (menu option 2)
AMMO:		.BLKW	1
GRENADES:	.BLKW	1
LIVES:		.BLKW	1
SCORE:		.BLKB	6	; six ASCII digits
		.EVEN
HUDDIRTY:	.BLKW	1

; ---- entity + object lists --------------------------------------
ENTS:		.BLKB	E.SIZE*NENT
		.EVEN
OBJLIST:	.BLKB	O.SIZE*NOBJ
		.EVEN

; ---- zone specials, built by ZONE_LOAD ---------------------------
NTPORT:		.BLKW	1	; teleport pads in this zone (0..NSPEC)
TPROW:		.BLKW	NSPEC	; cell of each pad (the CL_TPORT cell)
TPCOL:		.BLKW	NSPEC
NSUITP:		.BLKW	1	; power-suit booths (0..NSPEC)
SUITROW:	.BLKW	NSPEC
SUITCOL:	.BLKW	NSPEC
NEMIT:		.BLKW	1	; wall emitters in this zone (0..EMITMAX)
EMITROW:	.BLKW	EMITMAX
EMITCOL:	.BLKW	EMITMAX
EMITT:		.BLKW	EMITMAX	; frames before each may fire again
NMINE:		.BLKW	1	; the zone has a mine throwing missiles
MINEROW:	.BLKW	1	; and the cell it is anchored in
MINECOL:	.BLKW	1
NPICKUP:	.BLKW	1	; canisters placed in this zone
PICKS:		.BLKB	P.SIZE*NPICK
		.EVEN

; ---- display-list interpreter state (list.mac) -------------------
LROW:		.BLKW	1	; cursor, cell units, wrapped to 8 bits
LCOL:		.BLKW	1
LINK:		.BLKW	1	; current ink + 1
LBASE:		.BLKW	1	; tile bank base
LSOLID:		.BLKW	1	; collision class written with every cell
LHIT:		.BLKW	1
LERASE:		.BLKW	1	; nonzero: blank the cells instead of drawing
LSTKP:		.BLKW	1	; repeat stack pointer (bytes)
LSTK:		.BLKW	16.	; 8 x {count, resume address}

; ---- the dirty-cell bitmap (flow.mac) ----------------------------
; One bit per cell, two words per row.  MARK_RECT sets bits, and the
; blit pass pushes every dirty cell to the screen exactly once - a
; screen full of overlapping sprites used to blit the same cells
; several times over through the old rectangle list.
DIRTY:		.BLKW	2*NROWS
MRNEW:		.BLKW	1	; any bit newly set by the last MARK_RECT
MRROW:		.BLKW	1
MRML:		.BLKW	1	; the rectangle's two row masks
MRMR:		.BLKW	1
BLROW:		.BLKW	1	; blit pass cursors
BLVAL:		.BLKW	1
BLCOL:		.BLKW	1
BLLEN:		.BLKW	1
DRAWOFF:	.BLKW	1	; catch-up pass: update, but draw no sprites
DRAWSKIP:	.BLKW	1	; catch-up passes taken this frame
PAUSEREQ:	.BLKW	1	; АР2 seen during a catch-up pass
PAUSAVE:	.BLKW	12.

; ---- anim-hook cells filed by the display lists (opcode 0353) ----
HOOKN:		.BLKW	1
HOOKS:		.BLKB	3*NHOOK	; {class, row, col} per entry
		.EVEN

; ---- runtime scenery animations (anims.mac) ----------------------
NFLM:		.BLKW	1	; class-2 jet flames
FLMROW:		.BLKW	NFLAME
FLMCOL:		.BLKW	NFLAME
FLMPH:		.BLKW	1	; shared three-step phase

NCYC:		.BLKW	1	; class-4 colour-cycled cells, as runs
CYCROW:		.BLKB	NCYC4	; {row, first column, length} - the scan
CYCCOL:		.BLKB	NCYC4	; visits cells left to right, so a booth
CYCLEN:		.BLKB	NCYC4	; frame folds into a handful of runs
CYCPH:		.BLKW	1

NMIN5:		.BLKW	1	; land mines: {row, col, state} each
MINROW:		.BLKB	NMINE5
MINCOL:		.BLKB	NMINE5
MINST:		.BLKB	NMINE5	; 1 armed, 0 blown
		.EVEN

NPUMPS:		.BLKW	1	; the rising pumps
PMPCOL:		.BLKB	NPUMP
PMPROW:		.BLKB	NPUMP	; anchor (rest) row
PMPCUR:		.BLKB	NPUMP	; row it is drawn at now
PMPCNT:		.BLKB	NPUMP	; the original's 0x9C70 counter
		.EVEN

BEAMON:		.BLKW	1	; the vertical laser beam (one per zone)
BEAMROW:	.BLKW	1	; first beam cell
BEAMCOL:	.BLKW	1
BEAMLEN:	.BLKW	1	; cells down to the ground
BEAMHIT:	.BLKW	1	; laser bolts taken so far
BEAMPH:		.BLKW	1
BEAMSAVE:	.BLKW	2*24.	; {tile, slot+class} of the covered cells

; ---- the level gate (class 16) and its bonus screens -------------
GATEON:		.BLKW	1	; this zone has a level gate
GATEX:		.BLKW	1	; its trigger x, in 2-pixel units
GATEPTR:	.BLKW	1	; the bonus pointer's counter - like the
				; original's 0xA960 it runs on from one
				; gate to the next
GTROW:		.BLKW	1	; gate screen scratch
GTR2:		.BLKW	1
GTT:		.BLKW	1
GTF:		.BLKW	1
GTSL:		.BLKW	1
GTI:		.BLKW	1

FLYON:		.BLKW	1	; this zone has swooping flyers
FLYPATH:	.BLKW	1	; their path byte code
FLYFRB:		.BLKW	1	; 16x16 frame base
FLYCDV:		.BLKW	1	; frames between spawns
FLYCD:		.BLKW	1	; cooldown now
FLYS:		.BLKB	F.SIZE*NFLY
		.EVEN

; ---- scratch ----------------------------------------------------
ENTW:		.BLKW	1	; entity box for ENT_HITPLAYER, x units
ENTH:		.BLKW	1	; and pixels
				; (REVTAB and DUPTAB overlay the dead
				; CPU-side PPU block - see ppu_end.mac)
SPRSHIFT:	.BLKW	1
SPRMIR:		.BLKW	1	; nonzero = draw the frame mirrored
SPRH:		.BLKW	1	; lines of a 16x16 frame to draw (0 = all)
SPRC:		.BLKW	1	; cells it may touch across   (0 = all)
SPRB0:		.BLKW	1	; scratch for the mirror
SPRNOT:		.BLKW	1	; planes the sprite must not light
SPRY:		.BLKW	1
SPRSRC:		.BLKW	1
SPRDST:		.BLKW	1
TMPA:		.BLKW	1
TMPB:		.BLKW	1

; ---- scratch words moved out of the code modules (all of them
; written before they are read) ----------------------------------
BOLTX:		.BLKW	1
BOLTY:		.BLKW	1
BOLTS:		.BLKW	1
GRSTEPS:		.BLKW	1
GRIDX:		.BLKW	1
GRDY:		.BLKW	1
BALLDY:		.BLKW	1
BALLX:		.BLKW	1
BALLY:		.BLKW	1
BALLN:		.BLKW	1
BALLQ:		.BLKW	1
ECUR:		.BLKW	1
EMITI:		.BLKW	1
MINEFR:		.BLKW	1
BVSN:		.BLKW	1
BVSOBJ:		.BLKW	1
BVSW:		.BLKW	1
BVSH:		.BLKW	1
BVSMW:		.BLKW	1
BVSMH:		.BLKW	1
OCROW:		.BLKW	1
OCCOL:		.BLKW	1
OCW:		.BLKW	1
OCH:		.BLKW	1
GBOBJ:		.BLKW	1
GBN:		.BLKW	1
GBROW:		.BLKW	1
GBCOL:		.BLKW	1
GRROW:		.BLKW	1
GRCOL:		.BLKW	1
GRSPAN:		.BLKW	1
GRACC:		.BLKW	1
GRDELTA:		.BLKW	1
BOLTN:		.BLKW	1
FLMI:		.BLKW	1
CYCI:		.BLKW	1
MINI:		.BLKW	1
PMPI:		.BLKW	1
FLYI:		.BLKW	1
ARCF:		.BLKW	1
ARCX:		.BLKW	1
ARCY:		.BLKW	1
MENUC:		.BLKW	1
RNDTMP:		.BLKW	1
GAMEOVER:		.BLKW	1
ROWTMP:		.BLKW	1
CRW:		.BLKW	1
CRW0:		.BLKW	1
CRH:		.BLKW	1
CRC:		.BLKW	1
CRC0:		.BLKW	1
CRB:		.BLKW	1
CRB0:		.BLKW	1
HN_VAL:		.BLKW	1
HN_COL:		.BLKW	1
HN_INK:		.BLKW	1
HN_CNT:		.BLKW	1
PCROW:		.BLKW	1
PCCOL:		.BLKW	1
PCACC:		.BLKW	1
PSTEP:		.BLKW	1
PTRI:		.BLKW	1
PTCI:		.BLKW	1
PKROW:		.BLKW	1
PKCOL:		.BLKW	1
PL_FROM:		.BLKW	1
GUNT:		.BLKW	1
GUNROW:		.BLKW	1
GUNCOL:		.BLKW	1
ECUR_OBJ:		.BLKW	1

		. = 0		; back to the boot sector origin
